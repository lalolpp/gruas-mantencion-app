rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unico admin de la app (email/password). Si se crea otro usuario,
    // agregarlo a esta funcion.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'edo.electric@gmail.com';
    }
    function equipoValido() {
      return request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0;
    }
    function registroValido() {
      return request.resource.data.equipo is string
        && request.resource.data.fecha is string;
    }
    match /equipos/{doc} {
      allow read, write: if esAdmin()
        && (request.method == 'delete' || equipoValido());
    }
    match /registros/{doc} {
      allow read, write: if esAdmin()
        && (request.method == 'delete' || registroValido());
    }
    // Todo lo demas (colecciones futuras) queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}